{
  "name": "genea-public-ui",
  "private": true,
  "scripts": {
    "dev:ui": "vite --config vite.config.mts",
    "dev:ui:blind": "GENEA_UI_TARGET=blind vite --config vite.config.mts",
    "build:ui": "vite build --config vite.config.mts",
    "build:ui:blind": "GENEA_UI_TARGET=blind vite build --config vite.config.mts",
    "preview:ui": "vite preview --config vite.config.mts",
    "test:build:ui:blind": "npm run build:ui:blind && node --test frontend/blind-review/build-contract.test.mjs",
    "typecheck:ui": "vue-tsc -p tsconfig.ui.json --noEmit",
    "test:unit:ui:vue": "vitest run --config vitest.config.mts",
    "test:unit:ui:blind": "vitest run --config vitest.config.mts src/blind-review/api.spec.ts src/blind-review/BlindReviewApp.spec.ts",
    "test:unit:ui": "npm run test:unit:ui:vue",
    "test:ui:blind": "playwright test --config frontend/blind-review/playwright.config.cjs",
    "build:ui:demo": "GENEA_EMBED_PRESENTATION_DATA=1 vite build --config vite.config.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/geojson-vt": "^3.2.5",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "geojson-vt": "^4.0.3",
    "jsdom": "^29.0.1",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vt-pbf": "^3.1.3",
    "vue-tsc": "^3.3.11",
    "world-atlas": "^2.0.2"
  },
  "dependencies": {
    "maplibre-gl": "^6.6.0",
    "pinia": "^4.0.3",
    "pmtiles": "^4.5.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "license": "MIT"
}
