#!/usr/bin/env python3
"""Run the local CLI without installing the package."""

from pathlib import Path
import os
import sys

ROOT = Path(__file__).resolve().parent
VENV_PYTHON = ROOT / ".venv" / "bin" / "python"

# The private SQLCipher workspace needs the optional keyring/crypto extras.
# Prefer the project runtime when it exists so `./genea` does not accidentally
# start a system Python that can read the code but cannot unlock the database.
if VENV_PYTHON.is_file() and Path(sys.prefix).resolve() != (ROOT / ".venv").resolve():
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), str(Path(__file__).resolve()), *sys.argv[1:]])

sys.path.insert(0, str(ROOT / "src"))

from genea.cli import main


if __name__ == "__main__":
    raise SystemExit(main())
